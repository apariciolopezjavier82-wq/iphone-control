# 复制为 .env 后按需修改。所有项都可以留空，用默认值。.env 里有通知密钥，不要提交到 git。

# 容器名。改了的话，`iphone-control mcp-config --container <新名字>` 打印的注册命令和 README 里的 docker exec 都要跟着换
CONTAINER_NAME=iphone-control
# 镜像名（compose 构建出的本地镜像，或要拉取的发布镜像）
IMAGE=iphone-control:local
# 数据目录：配对记录、封存后的 Apple ID 会话和开发私钥、签好的 WDA、开发者镜像缓存、日志。
# 锁屏密码不再写在这里。旧的明文密码文件如果还在，程序不读取；确认后用 passcode clear 删除。务必备份，不要提交
DATA_DIR=./data

# 固定控制哪台设备，设了就不能切换。留空为自动选：正在控制的那台一直用到它断开；
# 运行中可以用 `iphone-control select` 或 iphone_select_device 工具切换
IPHONE_UDID=
# HID 后备路线换算坐标用的屏幕尺寸（点）：WDA 不可用、又没有这台设备的尺寸记录时才用（从没连上过 WDA，或切到记录里没有尺寸的设备）。
# 不分设备，接多台时要小心；一般留空
SCREEN_W=
SCREEN_H=

# 代理：下载开发者镜像、Apple ID 登录、构建镜像、发 Telegram 都会用；留空表示直连
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# 描述文件（免费账号 7 天有效）剩余不到几天时重签；每隔几小时检查一次（手机重新连上或切换设备后 1 分钟内也查一次）
RESIGN_MIN_DAYS=2
RESIGN_CHECK_HOURS=6
# 手机离线超过几分钟推送提醒；0 表示不提醒
OFFLINE_ALERT_MIN=10

# 通知：配了哪个就发哪个。触发场景：重签失败、Apple ID 会话失效、手机离线/恢复、重启后需要输密码、自动解锁失败
TG_BOT_TOKEN=
TG_CHAT_ID=
BARK_SERVER=https://api.day.app
BARK_KEY=

# 高级
# 自建 anisette 服务（默认用 Impactor 的第三方服务）
ICTL_ANISETTE_URL=
# 开发者镜像下载地址（默认社区维护的 doronz88/DeveloperDiskImage）
ICTL_DDI_URL=
# 自己从 Xcode 提取的开发者镜像目录。设了就不下载，也不会删里面的文件；缺文件时报错说明缺哪个
ICTL_DDI_DIR=
# 守护进程是否自己拉起 usbmuxd。默认：以 root 运行（容器）时拉起，以普通用户运行时用系统的 usbmuxd 服务。
# 以 root 从源码运行、宿主机又已有 usbmuxd 服务时设为 0
# ICTL_MANAGE_USBMUXD=0
# 守护进程自己拉起 usbmuxd 时用的可执行文件，默认 usbmuxd
# ICTL_USBMUXD_BIN=/usr/sbin/usbmuxd
# 未签名 WDA 的路径。默认：容器里是 /usr/share/iphone-control/WDA-unsigned.ipa；从源码运行是数据目录的 wda/WDA-unsigned.ipa，首次签名前下载
# ICTL_WDA_UNSIGNED=/path/to/WDA-unsigned.ipa
# 数据目录和控制接口（同 --data-dir、--socket）。容器里不要改。要改时不能留空，守护进程、命令行和 MCP 要用同样的值。
# 默认：root 是 /var/lib/iphone-control 和 /run/iphone-control/ctl.sock；
# 普通用户是 $XDG_DATA_HOME/iphone-control（没设时 ~/.local/share/iphone-control）和 $XDG_RUNTIME_DIR/iphone-control/ctl.sock（没有 XDG_RUNTIME_DIR 时放在数据目录里）
# ICTL_DATA_DIR=/path/to/data
# ICTL_SOCKET=/path/to/ctl.sock
# 日志级别（tracing EnvFilter 语法）
# ICTL_LOG=info,ictl_wda::http=debug
